{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node ferramentas/build-vercel.js",
  "outputDirectory": "site",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:rota*", "destination": "/api?rota=:rota*" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{servidor/**,banco/**}",
      "maxDuration": 20
    }
  }
}
